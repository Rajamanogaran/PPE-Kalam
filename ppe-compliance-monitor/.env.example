# PPE Kalam — Industry 12-factor env (copy to .env and edit)
# Generate SECRET_KEY: python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
DJANGO_SECRET_KEY=change-me-please-generate-a-strong-random-key-at-least-50-chars
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=*
DJANGO_CSRF_TRUSTED_ORIGINS=https://*.e2b.app,https://*.app.github.dev
# For prod: DJANGO_ALLOWED_HOSTS=yourdomain.com,api.yourdomain.com
# DJANGO_CSRF_TRUSTED_ORIGINS=https://yourdomain.com,https://*.yourdomain.com
# Database: leave empty for SQLite dev, or set for Postgres prod
# DATABASE_URL=postgres://ppe:ppe@db:5432/ppe_kalam
# REDIS_URL=redis://redis:6379/0
# Timezone
DJANGO_TIME_ZONE=Asia/Kolkata
# Security (prod)
# DJANGO_SECURE_SSL_REDIRECT=True
# PPE
PPE_ML_MODELS_DIR=ml_models
PPE_LOGS_DIR=logs
# Encrypt camera passwords at rest (generate: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())")
PPE_FERNET_KEY=
# PPE_FERNET_KEY=AbCdEfGhIjKlMnOpQrStUvWxYz1234567890_ABCDEF=
PPE_CAMERA_HEALTH_INTERVAL=60
PPE_API_PAGE_SIZE=20
# Optional: HSTS
# DJANGO_HSTS_SECONDS=31536000
